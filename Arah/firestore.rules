rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - more granular access control
    match /users/{userId} {
      // Allow users to read their own data
      allow get: if request.auth != null && request.auth.uid == userId;

      // Allow users to update their own profile data, but restrict sensitive fields
      // AND validate immutable fields like dateOfBirth
      allow update: if request.auth != null && request.auth.uid == userId
                    && !(request.resource.data.keys() hasAll ['isAdmin', 'isModerator', 'isBlocked', 'dateOfBirth'])
                    && (request.resource.data.keys() - resource.data.keys() hasSubset ['name', 'bio', 'experienceLevel', 'skills', 'photoUrl', 'githubUrl', 'linkedinUrl', 'isProfilePublic', 'username', 'country', 'lastSeen'])
                    // Validate dateOfBirth immutability - can only be set once
                    && (!request.resource.data.containsKey('dateOfBirth')
                        || request.resource.data.get('dateOfBirth') == resource.data.get('dateOfBirth'))
                    // Validate country is not longer than reasonable length
                    && (!request.resource.data.containsKey('country')
                        || request.resource.data.get('country').size() <= 100)
                    // Validate lastSeen is a timestamp (if present)
                    && (!request.resource.data.containsKey('lastSeen')
                        || request.resource.data.get('lastSeen') is timestamp);

      // Allow anyone to read public profiles
      allow get: if request.auth != null && get(/databases/$(database)/documents/users/$(userId)).data.isProfilePublic == true;

      // Admins and moderators can read all user data
      allow get: if request.auth != null
                 && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                      || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);

      // Admins and moderators can update certain fields (excluding sensitive ones that should only be changed via specific functions)
      allow update: if request.auth != null
                    && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true)
                    && !(request.resource.data.keys() hasAll ['isAdmin', 'isModerator']); // Prevent changing admin/moderator status directly
    }

    // Reports collection - allow authenticated users full access
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // Tasks collection - allow authenticated users full access
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Orders collection - allow authenticated users full access
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Chats collection - allow authenticated users full access
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      // Messages subcollection - allow authenticated users full access
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Notifications collection - allow users to read and update their own notifications
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow get, update: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow delete: if false; // Prevent direct deletion by users
    }

    // Default deny for unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}