rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - allow authenticated users full access to their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reports collection - allow authenticated users full access
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // Tasks collection - allow authenticated users full access
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Orders collection - allow authenticated users full access
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Chats collection - allow authenticated users full access
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      // Messages subcollection - allow authenticated users full access
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Default deny for unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
